# OFFGRID environment variables — copy to `.env` and fill in as needed.
# Phase 1 has no runtime secrets. This file exists so future phases can add
# variables (Supabase URL/keys for Phase 9 cloud sync, map tile server, etc.)
# without accidentally introducing them ad-hoc.

# --- Phase 9 (Cloud Sync) — DO NOT set until Phase 9 lands ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# --- Phase 7 (Offline Maps) — DO NOT set until Phase 7 lands ---
# MAP_TILE_SERVER=
